# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:ABC-dari-BotFather
# ID Telegram admin (pisahkan koma). Cek ID kamu: chat bot lalu ketik /id
TELEGRAM_ADMIN_IDS=
# Opsional — bisa juga diset dengan /setgroup di dalam grup
TELEGRAM_GROUP_CHAT_ID=

# ===== GitHub =====
GITHUB_REPO=infruity/infruity-erp
# Buat string acak panjang, isi juga di Settings > Webhooks > Secret
GITHUB_WEBHOOK_SECRET=
# branch:role (fe/be). Pola "frontend/*:fe" juga didukung untuk feature branch
BRANCH_ROLES=frontend:fe,backend:be
RELEASE_BRANCHES=main

# ===== Google =====
SPREADSHEET_ID=1bIe66RGbDhaMQ9lYWn_WQqIh0pZU0CwEtQllEcPuDS4
PLAN_SHEET_NAME=Plan
LOG_SHEET_NAME=Log Push
# kolom checkbox:catatan di tab Plan
PLAN_COLS_FE=B:C
PLAN_COLS_BE=D:E
DRIVE_FOLDER_ID=1-4h26lI5451dzfFcJYoYab2D3ak-dNCl
# OAuth (disarankan, hasil scripts/google_auth.py)
GOOGLE_TOKEN_FILE=secrets/token.json
# Alternatif: service account (hanya bisa upload jika folder ada di Shared Drive)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json

# ===== Perilaku =====
# feat = minta video hanya jika ada commit feat | always | never
VIDEO_MODE=feat
REMINDER_HOURS=6
TZ_NAME=Asia/Jakarta

# ===== Server =====
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/github/webhook
DB_PATH=data/bot.db

# ===== Local Bot API (opsional, video > 20 MB) =====
# Aktifkan bersama profile "localapi" di docker-compose
TELEGRAM_API_BASE_URL=
TELEGRAM_LOCAL_MODE=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
